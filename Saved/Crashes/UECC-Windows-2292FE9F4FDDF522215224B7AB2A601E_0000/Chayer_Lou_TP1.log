        # --- UI ---
        ("Project/UI/Blueprints", "Les Widgets (WBP_) pour l'interface."),
        ("Project/UI/Fonts", "Polices d'écriture."),
        ("Project/UI/Assets", "Images spécifiques à l'interface.")
    ]

    # 1. Création du dossier spécial _External
    eal.make_directory("/Game/_External/BaseTemplate")
    
    # 2. Boucle de création des dossiers et fichiers .txt
    content_dir = unreal.Paths.project_content_dir()
    
    for path, desc in folders_data:
        ue_path = "/Game/" + path
        eal.make_directory(ue_path)
        
        # Création physique du fichier description
        full_disk_path = os.path.join(content_dir, path)
        if not os.path.exists(full_disk_path):
            os.makedirs(full_disk_path)
            
        desc_file = os.path.join(full_disk_path, "DescriptionDossier.txt")
        with open(desc_file, "w", encoding="utf-8") as f:
            f.write(desc)

    unreal.log("SCRIPT 1 TERMINÉ : Structure et documentation créées.")

